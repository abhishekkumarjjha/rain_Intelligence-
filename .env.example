# Provider — Google Ads Transparency Center
SERPAPI_API_KEY=
SERPAPI_TC_REGION=2840          # SerpApi's own region ID space. 2840 = US.
SERPAPI_TIMEOUT_MS=20000

# Anthropic
ANTHROPIC_API_KEY=
RI_VISION_MODEL=claude-haiku-4-5-20251001
RI_ANALYSIS_MODEL=claude-sonnet-5

# Cost knob: creatives read per advertiser, per run. ONE VISION CALL EACH.
RI_MAX_READ=18

RI_DATA_DIR=./runs
PORT=3000
