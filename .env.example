# ═══════════════════════════════════════════════════════════════════════════
# PROVIDERS — two vendors, deliberately.
#
# They fail independently because they ARE independent: a missing SearchApi key
# disables Meta and leaves Google display working, and vice versa. Neither takes
# the product down. /api/health reports availability per source.
# ═══════════════════════════════════════════════════════════════════════════

# SerpApi — Google Ads Transparency Center (display + search creatives)
SERPAPI_API_KEY=
SERPAPI_TC_REGION=2840          # SerpApi's own region ID space. 2840 = US.
SERPAPI_TIMEOUT_MS=20000
SERPAPI_IMAGE_TIMEOUT_MS=12000

# SearchApi.io — Meta Ad Library. There is no native-Meta path: the official
# ads_archive API is gated behind per-person identity confirmation
# (OAuthException 10 / subcode 2332002), which is not a dependency a production
# tool should carry.
SEARCHAPI_API_KEY=
SEARCHAPI_TIMEOUT_MS=25000

# Anthropic
ANTHROPIC_API_KEY=
RI_VISION_MODEL=claude-haiku-4-5-20251001
RI_ANALYSIS_MODEL=claude-sonnet-5

# ═══════════════════════════════════════════════════════════════════════════
# COST KNOBS
# ═══════════════════════════════════════════════════════════════════════════

# Google: creatives read per advertiser, per run. ONE VISION CALL EACH.
RI_MAX_READ=30

# Meta: pages fetched per advertiser. SearchApi bills per request and a large
# advertiser can report 600 ads at ~30 a page, so exhausting one would cost ~20
# requests. Exhaustive capture is a thing a strategist asks for, not a default.
RI_META_MAX_PAGES=2

# Meta: distinct MESSAGES read by vision per advertiser. Applied AFTER message
# dedupe — reading every card when they carry a fraction that many distinct
# messages is paying several times for one answer.
RI_META_MAX_READ=18

# ═══════════════════════════════════════════════════════════════════════════
# CAPTURE CACHE
#
# Per advertiser, keyed on (source, domain, window) and NOT on product — capture
# is product-agnostic, so one capture of a competitor serves every product scope
# the team tests that week. Bank creative moves on a compliance cycle measured
# in weeks, which is why a week is the right default rather than a day.
#
# The Re-analyze button and the "Force fresh capture" checkbox both bypass it.
# ═══════════════════════════════════════════════════════════════════════════
RI_CAPTURE_TTL_DAYS=7

# The standing national tier — J.P. Morgan Chase and Capital One, appended to
# every Google display Creative capture without the user selecting them, exactly
# as slots 4 and 5 of RAIN's six-column analysis never change.
#
# They get their own TTL and read cap because their capture is SHARED: Chase's
# display advertising is identical no matter which client is being analysed, so
# it is bought once a month and amortised across every analysis anyone runs.
# That is also the argument for reading MORE of them, not fewer — the cost is
# paid once and the payoff (a wall worth opening) is per analysis.
RI_NATIONAL_TTL_DAYS=30
RI_NATIONAL_READ=30

# What counts as a RAIN-managed campaign. A regex over the ORIGINAL destination
# URL, evaluated before tracking parameters are stripped for message grouping.
# Configurable because campaign identifiers change; the default matches any
# rain-prefixed utm_source.
RI_RAIN_UTM_PATTERN=utm_source=rain[-_a-z0-9]*

# ═══════════════════════════════════════════════════════════════════════════
# PLATFORM
# ═══════════════════════════════════════════════════════════════════════════

# Holds runs, the extraction cache, the capture cache, stored Meta media and
# any Page identities confirmed at runtime.
#
# On a PaaS with an ephemeral filesystem this MUST point at a mounted disk.
# Losing it is not just a slow first run any more: stored Meta creatives go with
# it, and Meta's fbcdn URLs carry expiry tokens, so old runs come back with a
# wall of broken tiles rather than merely a cold cache.
RI_DATA_DIR=./runs

RI_MEDIA_TIMEOUT_MS=12000

PORT=3000
